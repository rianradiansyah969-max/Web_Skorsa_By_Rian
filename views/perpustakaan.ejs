<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perpustakaan Digital — <%= schoolName %></title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['"Space Grotesk"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                },
            },
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #080B12; color: #EAF0FC; }
        .font-display { font-family: 'Space Grotesk', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #080b12; }
        ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: #3b82f6; }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- NAVBAR -->
    <header class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
            <a href="/dashboard" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-cyan-500 flex items-center justify-center font-display font-bold text-white text-base">S1</div>
                <div>
                    <h1 class="font-display font-bold text-base leading-tight"><%= schoolName %></h1>
                    <p class="text-[11px] text-slate-400">Portal Perpustakaan Digital</p>
                </div>
            </a>
            
            <div class="flex items-center gap-3">
                <a href="/riwayat" class="text-xs font-semibold px-4 py-2 rounded-full border border-blue-500/50 text-blue-400 hover:bg-blue-600 hover:text-white transition shadow-sm">
                    📋 Riwayat Saya
                </a>
                <a href="/dashboard" class="text-xs font-semibold px-4 py-2 rounded-full border border-slate-700 hover:border-slate-500 text-slate-300 transition">
                    &larr; Dashboard
                </a>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="max-w-7xl mx-auto px-6 py-10 flex-grow w-full">
        
        <!-- HEADER KATALOG -->
        <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-cyan-400 bg-cyan-500/10 px-4 py-1.5 rounded-full border border-cyan-500/20">E-LIBRARY & LITERASI</span>
            <h2 class="font-display text-3xl sm:text-4xl font-bold mt-3">Katalog Perpustakaan Digital</h2>
            <p class="text-slate-400 text-sm mt-2">Cari, baca preview, dan pinjam koleksi novel serta komik favoritmu.</p>
            
            <!-- FORM PENCARIAN -->
            <div class="mt-6 flex gap-2 max-w-lg mx-auto">
                <input type="text" id="searchInput" onkeyup="filterBooks()" placeholder="Cari judul buku, komik, atau pengarang..." class="w-full bg-slate-900 border border-slate-800 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-blue-500 transition shadow-inner">
            </div>

            <!-- TAB NAVIGASI KATEGORI -->
            <div class="mt-6 flex flex-wrap justify-center gap-2">
                <button onclick="switchTab('semua', event)" class="tab-btn active text-xs font-semibold px-4 py-2 rounded-xl border border-blue-500 bg-blue-600 text-white transition shadow">
                    ✨ Semua Koleksi
                </button>
                <button onclick="switchTab('novel', event)" class="tab-btn text-xs font-semibold px-4 py-2 rounded-xl border border-slate-800 bg-slate-900 text-slate-400 hover:border-slate-700 transition">
                    📚 Hanya Novel
                </button>
                <button onclick="switchTab('komik', event)" class="tab-btn text-xs font-semibold px-4 py-2 rounded-xl border border-slate-800 bg-slate-900 text-slate-400 hover:border-slate-700 transition">
                    🎨 Hanya Komik
                </button>
                <button onclick="switchTab('tersedia', event)" class="tab-btn text-xs font-semibold px-4 py-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 transition">
                    ✅ Hanya Tersedia
                </button>
            </div>
        </div>

        <!-- DUA KOLOM SEJAJAR (NOVEL DI KIRI | KOMIK DI KANAN) -->
        <div class="grid lg:grid-cols-2 gap-8 items-start" id="katalogContainer">
            
            <!-- KOLOM KIRI: NOVEL & FIKSI -->
            <section id="colNovel" class="bg-slate-950/40 border border-slate-800/80 rounded-3xl p-6 backdrop-blur-sm">
                <div class="flex items-center justify-between mb-6 border-b border-slate-800/80 pb-4">
                    <div class="flex items-center gap-2.5">
                        <span class="text-2xl">📚</span>
                        <div>
                            <h3 class="font-display font-bold text-lg text-white">Koleksi Novel & Fiksi</h3>
                            <p class="text-[11px] text-slate-400">Karya sastra & cerita rekaan populer</p>
                        </div>
                    </div>
                    <span class="text-xs font-mono font-bold bg-blue-500/10 text-blue-400 px-3 py-1 rounded-full border border-blue-500/20">
                        <%= katalogBuku.filter(b => b.kategori.includes('Novel') || b.kategori.includes('Fiksi')).length %> Judul
                    </span>
                </div>

                <div class="space-y-4">
                    <% katalogBuku.filter(b => b.kategori.includes('Novel') || b.kategori.includes('Fiksi')).forEach((buku) => { %>
                        <div class="book-card bg-slate-900/80 border border-slate-800/90 rounded-2xl p-3.5 flex gap-4 transition duration-300 hover:border-blue-500/50 hover:bg-slate-900"
                             data-category="Novel" 
                             data-stok="<%= buku.stok %>">
                            
                            <img src="<%= buku.cover %>" alt="<%= buku.judul %>" class="w-20 h-28 object-cover rounded-xl shrink-0 border border-slate-800 shadow-md">
                            
                            <div class="flex flex-col justify-between w-full">
                                <div>
                                    <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20"><%= buku.kategori %></span>
                                    <h4 class="font-bold text-sm mt-1.5 line-clamp-1 text-slate-100 leading-snug"><%= buku.judul %></h4>
                                    <p class="text-xs text-slate-400 mt-0.5"><%= buku.pengarang %></p>
                                </div>
                                
                                <div class="mt-2 pt-2 border-t border-slate-800/80 flex flex-col gap-2">
                                    <div class="flex items-center justify-between text-xs">
                                        <% if(buku.stok > 0) { %>
                                            <span class="text-emerald-400 font-semibold text-[11px] flex items-center gap-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span> Tersedia (<%= buku.stok %>)
                                            </span>
                                        <% } else { %>
                                            <span class="text-rose-400 font-semibold text-[11px] flex items-center gap-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500 inline-block"></span> Habis
                                            </span>
                                        <% } %>
                                    </div>

                                    <div class="flex gap-2">
                                        <button onclick="openPreview('<%= buku.judul %>', '<%= buku.pengarang %>', '<%= buku.preview %>')" 
                                                class="w-1/2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-[11px] py-1.5 rounded-lg transition border border-slate-700">
                                            📖 Preview
                                        </button>
                                        
                                        <% if(buku.stok > 0) { %>
                                            <button onclick="openPinjamModal('<%= buku.judul %>', '<%= buku.pengarang %>')" 
                                                    class="w-1/2 bg-blue-600 hover:bg-blue-500 text-white font-semibold text-[11px] py-1.5 rounded-lg transition shadow">
                                                Pinjam &rarr;
                                            </button>
                                        <% } else { %>
                                            <button disabled class="w-1/2 bg-slate-800/60 text-slate-500 cursor-not-allowed font-semibold text-[11px] py-1.5 rounded-lg">
                                                Habis
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </section>

            <!-- KOLOM KANAN: KOMIK & MANGA -->
            <section id="colKomik" class="bg-slate-950/40 border border-slate-800/80 rounded-3xl p-6 backdrop-blur-sm">
                <div class="flex items-center justify-between mb-6 border-b border-slate-800/80 pb-4">
                    <div class="flex items-center gap-2.5">
                        <span class="text-2xl">🎨</span>
                        <div>
                            <h3 class="font-display font-bold text-lg text-white">Koleksi Komik & Manga</h3>
                            <p class="text-[11px] text-slate-400">Cerita bergambar & manga petualangan</p>
                        </div>
                    </div>
                    <span class="text-xs font-mono font-bold bg-cyan-500/10 text-cyan-400 px-3 py-1 rounded-full border border-cyan-500/20">
                        <%= katalogBuku.filter(b => b.kategori.includes('Komik') || b.kategori.includes('Manga')).length %> Judul
                    </span>
                </div>

                <div class="space-y-4">
                    <% katalogBuku.filter(b => b.kategori.includes('Komik') || b.kategori.includes('Manga')).forEach((buku) => { %>
                        <div class="book-card bg-slate-900/80 border border-slate-800/90 rounded-2xl p-3.5 flex gap-4 transition duration-300 hover:border-cyan-500/50 hover:bg-slate-900"
                             data-category="Komik" 
                             data-stok="<%= buku.stok %>">
                            
                            <img src="<%= buku.cover %>" alt="<%= buku.judul %>" class="w-20 h-28 object-cover rounded-xl shrink-0 border border-slate-800 shadow-md">
                            
                            <div class="flex flex-col justify-between w-full">
                                <div>
                                    <span class="text-[9px] font-mono font-bold px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20"><%= buku.kategori %></span>
                                    <h4 class="font-bold text-sm mt-1.5 line-clamp-1 text-slate-100 leading-snug"><%= buku.judul %></h4>
                                    <p class="text-xs text-slate-400 mt-0.5"><%= buku.pengarang %></p>
                                </div>
                                
                                <div class="mt-2 pt-2 border-t border-slate-800/80 flex flex-col gap-2">
                                    <div class="flex items-center justify-between text-xs">
                                        <% if(buku.stok > 0) { %>
                                            <span class="text-emerald-400 font-semibold text-[11px] flex items-center gap-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span> Tersedia (<%= buku.stok %>)
                                            </span>
                                        <% } else { %>
                                            <span class="text-rose-400 font-semibold text-[11px] flex items-center gap-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500 inline-block"></span> Habis
                                            </span>
                                        <% } %>
                                    </div>

                                    <div class="flex gap-2">
                                        <button onclick="openPreview('<%= buku.judul %>', '<%= buku.pengarang %>', '<%= buku.preview %>')" 
                                                class="w-1/2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-[11px] py-1.5 rounded-lg transition border border-slate-700">
                                            📖 Preview
                                        </button>
                                        
                                        <% if(buku.stok > 0) { %>
                                            <button onclick="openPinjamModal('<%= buku.judul %>', '<%= buku.pengarang %>')" 
                                                    class="w-1/2 bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-[11px] py-1.5 rounded-lg transition shadow">
                                                Pinjam &rarr;
                                            </button>
                                        <% } else { %>
                                            <button disabled class="w-1/2 bg-slate-800/60 text-slate-500 cursor-not-allowed font-semibold text-[11px] py-1.5 rounded-lg">
                                                Habis
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </section>

        </div>
    </main>

    <!-- MODAL POP-UP PREVIEW E-BOOK -->
    <div id="previewModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-3xl p-6 shadow-2xl relative">
            <button onclick="closePreview()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-lg font-bold">&times;</button>
            <span class="text-[10px] font-mono font-bold text-cyan-400 uppercase tracking-wider">E-Book Sampel Preview</span>
            <h3 id="previewJudul" class="font-bold text-lg text-white mt-1"></h3>
            <p id="previewPengarang" class="text-xs text-slate-400 mb-4"></p>
            
            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-sm leading-relaxed text-slate-300 max-h-60 overflow-y-auto italic font-serif" id="previewTeks">
            </div>
            
            <button onclick="closePreview()" class="w-full mt-5 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold py-2.5 rounded-xl transition">
                Tutup Preview
            </button>
        </div>
    </div>

    <!-- MODAL FORM PEMINJAMAN DIGITAL -->
    <div id="pinjamModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-md rounded-3xl p-6 shadow-2xl relative">
            <button onclick="closePinjamModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-lg font-bold">&times;</button>
            <h3 class="font-bold text-base text-white mb-1">Form Peminjaman Digital</h3>
            <p id="pinjamJudul" class="text-xs text-blue-400 mb-4 font-semibold"></p>
            
            <form onsubmit="confirmPinjam(event)" class="space-y-3">
                <input type="hidden" id="inputJudulBuku">
                <input type="hidden" id="inputPengarang">

                <div>
                    <label class="block text-xs text-slate-300 mb-1">Nama Siswa</label>
                    <input type="text" id="inputNamaSiswa" required placeholder="Nama Lengkap" class="w-full bg-slate-800 border border-slate-700 text-xs rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs text-slate-300 mb-1">NISN / Kartu Pelajar</label>
                    <input type="text" id="inputNisn" required placeholder="Contoh: 0051234567" class="w-full bg-slate-800 border border-slate-700 text-xs rounded-xl px-3.5 py-2.5 text-white focus:outline-none focus:border-blue-500">
                </div>
                <button type="submit" id="btnSubmitPinjam" class="w-full bg-gradient-to-r from-blue-600 to-cyan-500 hover:brightness-110 text-white font-bold text-xs py-3 rounded-xl transition mt-2 shadow-lg">
                    Proses Peminjaman
                </button>
            </form>
        </div>
    </div>

    <!-- MODAL SUKSES MODERN (MENGGANTIKAN ALERT BAWAAN BROWSER) -->
    <div id="successModal" class="fixed inset-0 bg-black/80 backdrop-blur-md hidden items-center justify-center z-50 p-4">
        <div class="bg-slate-900 border border-emerald-500/30 w-full max-w-sm rounded-3xl p-6 text-center shadow-2xl relative">
            <div class="w-16 h-16 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
                ✓
            </div>
            <h3 class="font-bold text-lg text-white">Peminjaman Berhasil!</h3>
            <p class="text-xs text-slate-400 mt-2 leading-relaxed">
                Pengajuan peminjaman berhasil diproses. Kamu akan otomatis diarahkan ke menu <span class="text-blue-400 font-semibold">"Riwayat Saya"</span>.
            </p>
            <button onclick="redirectKeRiwayat()" class="w-full mt-5 bg-gradient-to-r from-emerald-600 to-teal-500 hover:brightness-110 text-white text-xs font-bold py-3 rounded-xl transition shadow-lg">
                Lihat Riwayat Saya &rarr;
            </button>
        </div>
    </div>

    <footer class="border-t border-slate-800/80 py-6 text-center text-xs text-slate-500">
        &copy; <%= new Date().getFullYear() %> Perpustakaan Digital <%= schoolName %>. All rights reserved.
    </footer>

    <!-- SCRIPT UTAMA -->
    <script>
        let currentMode = 'semua';

        // Preview E-Book
        function openPreview(judul, pengarang, preview) {
            document.getElementById('previewJudul').textContent = judul;
            document.getElementById('previewPengarang').textContent = 'Karya: ' + pengarang;
            document.getElementById('previewTeks').textContent = '"' + preview + '"';
            document.getElementById('previewModal').classList.remove('hidden');
            document.getElementById('previewModal').classList.add('flex');
        }

        function closePreview() {
            document.getElementById('previewModal').classList.add('hidden');
            document.getElementById('previewModal').classList.remove('flex');
        }

        // Form Pinjam Modal
        function openPinjamModal(judul, pengarang) {
            document.getElementById('pinjamJudul').textContent = judul;
            document.getElementById('inputJudulBuku').value = judul;
            document.getElementById('inputPengarang').value = pengarang || '';
            document.getElementById('pinjamModal').classList.remove('hidden');
            document.getElementById('pinjamModal').classList.add('flex');
        }

        function closePinjamModal() {
            document.getElementById('pinjamModal').classList.add('hidden');
            document.getElementById('pinjamModal').classList.remove('flex');
        }

        function redirectKeRiwayat() {
            window.location.href = '/riwayat';
        }

        // Confirm Pinjam
        async function confirmPinjam(e) {
            e.preventDefault();

            const btnSubmit = document.getElementById('btnSubmitPinjam');
            btnSubmit.disabled = true;
            btnSubmit.textContent = 'Memproses...';

            const judulBuku = document.getElementById('inputJudulBuku').value;
            const pengarang = document.getElementById('inputPengarang').value;
            const namaSiswa = document.getElementById('inputNamaSiswa').value;
            const nisn = document.getElementById('inputNisn').value;

            try {
                const response = await fetch('/pinjam', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ judulBuku, pengarang, namaSiswa, nisn })
                });

                const result = await response.json();

                if (result.success) {
                    closePinjamModal();
                    
                    // Tampilkan Modal Sukses Modern
                    const successModal = document.getElementById('successModal');
                    successModal.classList.remove('hidden');
                    successModal.classList.add('flex');

                    // Pindah otomatis ke riwayat setelah 2 detik
                    setTimeout(() => {
                        redirectKeRiwayat();
                    }, 2000);
                } else {
                    alert('Gagal meminjam.');
                    btnSubmit.disabled = false;
                    btnSubmit.textContent = 'Proses Peminjaman';
                }
            } catch (err) {
                console.error('Error:', err);
                alert('Terjadi kesalahan server.');
                btnSubmit.disabled = false;
                btnSubmit.textContent = 'Proses Peminjaman';
            }
        }

        // Switch Tab Mode
        function switchTab(mode, evt) {
            currentMode = mode;
            
            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => {
                btn.classList.remove('bg-blue-600', 'text-white', 'border-blue-500');
                btn.classList.add('bg-slate-900', 'text-slate-400', 'border-slate-800');
            });

            if (evt && evt.target) {
                evt.target.classList.add('bg-blue-600', 'text-white', 'border-blue-500');
                evt.target.classList.remove('bg-slate-900', 'text-slate-400', 'border-slate-800');
            }

            const colNovel = document.getElementById('colNovel');
            const colKomik = document.getElementById('colKomik');
            const container = document.getElementById('katalogContainer');

            if (mode === 'novel') {
                colNovel.style.display = 'block';
                colKomik.style.display = 'none';
                container.classList.remove('lg:grid-cols-2');
                container.classList.add('max-w-3xl', 'mx-auto');
            } else if (mode === 'komik') {
                colNovel.style.display = 'none';
                colKomik.style.display = 'block';
                container.classList.remove('lg:grid-cols-2');
                container.classList.add('max-w-3xl', 'mx-auto');
            } else {
                colNovel.style.display = 'block';
                colKomik.style.display = 'block';
                container.classList.add('lg:grid-cols-2');
                container.classList.remove('max-w-3xl', 'mx-auto');
            }

            filterBooks();
        }

        // Filter Pencarian
        function filterBooks() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.getElementsByClassName('book-card');

            for (let card of cards) {
                const stok = parseInt(card.getAttribute('data-stok'));
                const text = card.textContent.toLowerCase();

                let matchTersedia = (currentMode !== 'tersedia') || (stok > 0);
                let matchSearch = text.includes(search);

                if (matchTersedia && matchSearch) {
                    card.style.display = "flex";
                } else {
                    card.style.display = "none";
                }
            }
        }
    </script>
</body>
</html>