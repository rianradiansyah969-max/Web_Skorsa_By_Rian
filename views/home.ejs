<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= namaSekolah %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans text-gray-800">

    <!-- Header / Navbar -->
    <header class="bg-blue-900 text-white shadow-md">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <h1 class="text-xl font-bold"><%= namaSekolah %></h1>
            <nav class="space-x-4">
                <a href="/" class="hover:underline">Beranda</a>
                <a href="#profil" class="hover:underline">Profil</a>
                <a href="#jurusan" class="hover:underline">Jurusan</a>
                <a href="#kontak" class="hover:underline">Kontak</a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="bg-blue-800 text-white py-20 text-center">
        <h2 class="text-4xl font-extrabold mb-2">Selamat Datang di <%= namaSekolah %></h2>
        <p class="text-lg text-blue-200">Mencetak Generasi Unggul, Siap Kerja, dan Berkarakter</p>
    </section>

    <!-- Profil Section -->
    <section id="profil" class="container mx-auto px-6 py-12">
        <div class="bg-white p-8 rounded-lg shadow-md">
            <h3 class="text-2xl font-bold text-blue-900 mb-4">Profil Sekolah</h3>
            <p class="leading-relaxed text-gray-600">
                <%= namaSekolah %> merupakan sekolah kejuruan berprestasi yang berfokus pada pengembangan keterampilan teknis, pembentukan karakter peserta didik, serta kesiapan dalam menghadapi dunia kerja maupun perguruan tinggi.
            </p>
        </div>
    </section>

    <!-- Jurusan Section -->
    <section id="jurusan" class="container mx-auto px-6 py-12">
        <h3 class="text-2xl font-bold text-blue-900 text-center mb-8">Program Keahlian</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-blue-900">
                <h4 class="font-bold text-xl mb-2 text-blue-800">Teknik Komputer & Jaringan</h4>
                <p class="text-gray-600 text-sm">Mempelajari jaringan komputer, instalasi server, troubleshooting, dan sistem keamanan IT.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-blue-900">
                <h4 class="font-bold text-xl mb-2 text-blue-800">Rekayasa Perangkat Lunak</h4>
                <p class="text-gray-600 text-sm">Fokus pada pembuatan aplikasi web, mobile, basis data, dan pemrograman modern.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-blue-900">
                <h4 class="font-bold text-xl mb-2 text-blue-800">Akuntansi & Keuangan</h4>
                <p class="text-gray-600 text-sm">Mempelajari pencatatan keuangan, perpajakan, audit, dan aplikasi akuntansi digital.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer id="kontak" class="bg-gray-900 text-white py-6 text-center">
        <p>&copy; <%= tahun %> <%= namaSekolah %>. All Rights Reserved.</p>
    </footer>

</body>
</html>